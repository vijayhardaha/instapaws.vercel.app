# =======================================================================
# InstaPaws — Environment Variables
# =======================================================================
# Copy this file to .env.local and fill in your values.
#
#   cp .env.example .env.local
#
# For local Supabase (Docker):
#   supabase start   # prints the local credentials
#
# For remote Supabase:
#   Project Settings → API → Project URL, Publishable Key, Service Role Key
# =======================================================================

# ── Supabase ──────────────────────────────────────────────────────────

# Project URL (https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Publishable (anon) key — safe for client-side use
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key — server-side admin operations only; NEVER expose publicly
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Overrides (optional) ──────────────────────────────────────────────

# Custom base URL when not running on Vercel (e.g., staging on custom domain)
# NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Port override (defaults to 3000)
# PORT=4000
# Google Analytics measurement ID (production only)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
